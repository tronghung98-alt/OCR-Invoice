GEMINI_API_KEY=dien_api_key_cua_ban_vao_day
# Ten model: xem danh sach tai https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=
# GEMINI_RETRIES=3

# Tai khoan quan tri dau tien (chi dung khi CSDL chua co tai khoan nao).
# Dang nhap xong nen doi mat khau va xoa 2 dong nay.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi_mat_khau_nay

# CSDL: bo trong = SQLite (file data/app.db).
# MySQL / MariaDB (can: pip install pymysql):
# DATABASE_URL=mysql+pymysql://dntt:matkhau@localhost:3306/dntt
# PostgreSQL (can: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://dntt:matkhau@localhost:5432/dntt

# So de nghi tu dong
# SO_DE_NGHI_FORMAT={stt:02d}-{dd}{mm}/ĐN-{yyyy}
# SO_DE_NGHI_RESET=day

# MAX_UPLOAD_MB=20
# MAX_FILES_PER_UPLOAD=10
# SESSION_HOURS=10
# Bat khi chay sau HTTPS:
# COOKIE_SECURE=true

# ---- Vong lap AI ----
# WORKER_POLL_SECONDS=3      # khong co hoa don moi thi kiem tra lai sau bay nhieu giay
# SELF_CHECK_REREADS=1       # tu kiem tra nghi sai -> AI doc lai toi da bay nhieu lan
# MAX_TRANSIENT_ATTEMPTS=5   # Gemini qua tai -> thu lai bay nhieu vong roi chuyen "Can nguoi xu ly"

# ---- Gui mail cho quan ly ----
# De trong SMTP_HOST: mail luu thanh file .eml trong data/outbox (de thu, chua gui that)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ban@gmail.com, SMTP_PASSWORD=<App Password 16 ky tu>
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURITY=starttls     # starttls | ssl | none
# MAIL_FROM=
# Dia chi web quan ly mo duoc tu may cua ho (cho nut Xac nhan trong mail):
# PUBLIC_BASE_URL=http://192.168.1.25:8000
# CONFIRM_LINK_DAYS=30
